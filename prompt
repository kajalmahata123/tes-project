import os
import anthropic
import logging
from typing import Optional, Dict, Any
from datetime import datetime

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

class VisaChatHandler:
    def __init__(self, api_key: Optional[str] = None):
        """Initialize chat handler with API key."""
        self.api_key = api_key or os.environ.get('ANTHROPIC_API_KEY')
        if not self.api_key:
            raise ValueError("ANTHROPIC_API_KEY environment variable must be set")
        self.client = anthropic.Client(api_key=self.api_key)

    def _build_system_prompt(self) -> str:
        """Build system prompt for VISA technical assistant."""
        return """You are a specialized technical assistant for VISA payment network documentation and ISO 8583 message processing. Your expertise includes:

1. ISO 8583 Message Standards
   - Message types and formats
   - Field specifications
   - Mandatory and optional fields
   - Data element formats
   - Validation rules

2. VISA Network Processing
   - Transaction flows
   - Authorization processing
   - Financial messages
   - Reversals and adjustments
   - Network management

3. Technical Specifications
   - Message structures
   - Field requirements
   - Processing codes
   - Response codes
   - Security requirements

4. Implementation Requirements
   - Integration guidelines
   - Testing procedures
   - Certification requirements
   - Error handling
   - Security standards

When responding to queries:
- Focus on technical accuracy
- Reference specific field numbers and codes
- Explain message flows and dependencies
- Highlight mandatory requirements
- Note any conditional rules
- Include relevant security considerations

Maintain a professional, technical tone while making complex information accessible."""

    def _build_analysis_prompt(self, query: str, context: str) -> str:
        """Build specialized prompt for VISA documentation analysis."""
        return f"""Here is the technical documentation context to analyze:

Context from VISA Documentation:
---
{context}
---

Technical Query: {query}

Please analyze the documentation and provide a detailed technical response following these guidelines:

1. Message Analysis (if applicable):
   - Identify message type (MTI)
   - List required fields
   - Specify format requirements
   - Note processing conditions
   - Explain field dependencies

2. Field Analysis (if applicable):
   - Provide field specifications
   - Detail format requirements
   - Explain validation rules
   - Note usage conditions
   - Highlight restrictions

3. Processing Requirements:
   - Outline processing steps
   - Specify timing requirements
   - List validation checks
   - Note security requirements
   - Explain error handling

4. Implementation Guidance:
   - Provide technical details
   - Note integration requirements
   - Highlight critical considerations
   - Reference relevant standards
   - Include testing guidance

5. Response Structure:
   - Start with direct answer
   - Support with specifications
   - Include field references
   - Quote relevant documentation
   - Add technical explanations

Please provide a comprehensive technical response:"""

    async def handle_chat_query(self,
                              query: str,
                              context: str,
                              conversation_history: Optional[str] = None) -> Dict[str, Any]:
        """
        Handle chat query with VISA technical documentation context.
        
        Args:
            query: User's technical query
            context: Relevant documentation context
            conversation_history: Optional conversation history
            
        Returns:
            Dict containing response and metadata
        """
        try:
            logger.info(f"Processing technical query: {query[:50]}...")

            # Input validation
            if not query.strip():
                return {
                    "error": "Query cannot be empty",
                    "response": None
                }
            if not context.strip():
                return {
                    "error": "Context cannot be empty",
                    "response": None
                }

            # Build messages
            messages = [
                {
                    "role": "system",
                    "content": self._build_system_prompt()
                }
            ]

            # Add conversation history if provided
            if conversation_history:
                messages.append({
                    "role": "assistant",
                    "content": conversation_history
                })

            # Add current query with analysis prompt
            messages.append({
                "role": "user",
                "content": self._build_analysis_prompt(query, context)
            })

            try:
                # Get response from Claude
                response = self.client.messages.create(
                    model="claude-3-sonnet-20240229",
                    max_tokens=1024,
                    temperature=0,
                    messages=messages
                )

                if not response or not response.content:
                    return {
                        "error": "Failed to generate response",
                        "response": None
                    }

                return {
                    "error": None,
                    "response": response.content[0].text.strip(),
                    "metadata": {
                        "timestamp": datetime.now().isoformat(),
                        "query_type": self._classify_query_type(query),
                        "context_length": len(context)
                    }
                }

            except anthropic.APIError as api_error:
                logger.error(f"API Error: {str(api_error)}")
                return {
                    "error": f"API Error: {str(api_error)}",
                    "response": None
                }

        except Exception as e:
            logger.error(f"Error handling query: {str(e)}")
            return {
                "error": f"Internal error: {str(e)}",
                "response": None
            }

    def _classify_query_type(self, query: str) -> str:
        """Classify the type of technical query."""
        query_lower = query.lower()
        
        if any(term in query_lower for term in ["field", "de", "data element"]):
            return "field_specification"
        elif any(term in query_lower for term in ["message", "mti", "format"]):
            return "message_format"
        elif any(term in query_lower for term in ["process", "flow", "transaction"]):
            return "processing_flow"
        elif any(term in query_lower for term in ["security", "encrypt", "authenticate"]):
            return "security_requirement"
        elif any(term in query_lower for term in ["error", "response code", "decline"]):
            return "error_handling"
        elif any(term in query_lower for term in ["implement", "integrate", "test"]):
            return "implementation"
        else:
            return "general_technical"

