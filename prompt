import os
import anthropic
import logging
from typing import Optional, Dict, Any
from datetime import datetime

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

class VisaChatHandler:
    def __init__(self, api_key: Optional[str] = None):
        """Initialize chat handler with API key."""
        self.api_key = api_key or os.environ.get('ANTHROPIC_API_KEY')
        if not self.api_key:
            raise ValueError("ANTHROPIC_API_KEY environment variable must be set")
        self.client = anthropic.Client(api_key=self.api_key)

    def _build_system_prompt(self) -> str:
        """Build system prompt for VISA technical assistant."""
        return """You are a specialized technical assistant for VISA payment network documentation and ISO 8583 message processing.

Key Technical Areas:
1. ISO 8583 Message Standards
   - Message types and structures
   - Field specifications
   - Data element formats
   - Validation rules

2. VISA Network Processing
   - Transaction flows
   - Message requirements
   - Network protocols
   - Security standards

Response Requirements:
1. Write direct, professional responses
2. Start immediately with technical content
3. Never use phrases like:
   - "Based on the documentation..."
   - "I will focus on..."
   - "Let me explain..."
   - "I'll help you understand..."
   - "According to the documentation..."
   
4. Structure responses with:
   - Technical specifications first
   - Field requirements and formats
   - Processing rules and conditions
   - Implementation requirements

5. Always include:
   - Specific field numbers
   - Message type indicators
   - Format specifications
   - Required values

Formatting:
1. Use clear hierarchical structure
2. Include relevant codes and values
3. Specify exact requirements
4. Note mandatory vs optional elements"""

    def _build_analysis_prompt(self, query: str, context: str) -> str:
        """Build specialized prompt for VISA documentation analysis."""
        return f"""Technical Documentation Context:
---
{context}
---

Technical Query: {query}

Required Response Format:

1. Technical Specifications
   - MTI and message formats
   - Field numbers and requirements
   - Data formats and lengths
   - Processing conditions

2. Implementation Requirements
   - Validation rules
   - Processing steps
   - Security requirements
   - Error handling

3. Format Guidelines
   - Start with direct technical content
   - Use field numbers and codes
   - Include exact specifications
   - Note all dependencies

4. Response Sections:
   Message Requirements:
   - List exact fields
   - Specify formats
   - Note conditions

   Processing Rules:
   - Detail steps
   - List validations
   - Specify timing

   Technical Notes:
   - Implementation details
   - Security requirements
   - Error handling

Provide technical response:"""

    async def handle_chat_query(self,
                              query: str,
                              context: str,
                              conversation_history: Optional[str] = None) -> Dict[str, Any]:
        """
        Handle chat query with VISA technical documentation context.
        
        Args:
            query: User's technical query
            context: Relevant documentation context
            conversation_history: Optional conversation history
            
        Returns:
            Dict containing response and metadata
        """
        try:
            logger.info(f"Processing technical query: {query[:50]}...")

            if not query.strip() or not context.strip():
                return {
                    "error": "Query and context required",
                    "response": None
                }

            messages = [
                {
                    "role": "system",
                    "content": self._build_system_prompt()
                }
            ]

            if conversation_history:
                messages.append({
                    "role": "assistant",
                    "content": conversation_history
                })

            messages.append({
                "role": "user",
                "content": self._build_analysis_prompt(query, context)
            })

            try:
                response = self.client.messages.create(
                    model="claude-3-sonnet-20240229",
                    max_tokens=1024,
                    temperature=0,
                    messages=messages
                )

                if not response or not response.content:
                    return {
                        "error": "Response generation failed",
                        "response": None
                    }

                return {
                    "error": None,
                    "response": response.content[0].text.strip(),
                    "metadata": {
                        "timestamp": datetime.now().isoformat(),
                        "query_type": self._classify_query_type(query)
                    }
                }

            except anthropic.APIError as api_error:
                logger.error(f"API Error: {str(api_error)}")
                return {
                    "error": str(api_error),
                    "response": None
                }

        except Exception as e:
            logger.error(f"Error: {str(e)}")
            return {
                "error": str(e),
                "response": None
            }

    def _classify_query_type(self, query: str) -> str:
        """Classify the type of technical query."""
        query_lower = query.lower()
        
        if any(term in query_lower for term in ["field", "de", "data element"]):
            return "field_specification"
        elif any(term in query_lower for term in ["message", "mti", "format"]):
            return "message_format"
        elif any(term in query_lower for term in ["process", "flow", "transaction"]):
            return "processing_flow"
        elif any(term in query_lower for term in ["security", "encrypt"]):
            return "security_requirement"
        elif any(term in query_lower for term in ["error", "response code"]):
            return "error_handling"
        else:
            return "general_technical"

