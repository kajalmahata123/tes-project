import os
import anthropic
import logging
from typing import Optional

logger = logging.getLogger(__name__)

# Initialize Claude client
claude_key = os.environ.get('ANTHROPIC_API_KEY')
if not claude_key:
    raise Exception("ANTHROPIC_API_KEY environment variable must be set")

client = anthropic.Client(api_key=claude_key)

def get_llm_response(query: str, context: str, conversation_history: str = "") -> str:
    """
    Get response from Claude using query, context, and conversation history
    """
    try:
        logger.info(f"Sending request to Claude with query: {query[:50]}...")
        
        # Safety check for inputs
        if not query.strip() or not context.strip():
            logger.error("Empty query or context provided")
            return "I apologize, but I need both a question and context to provide a meaningful response."

        # Construct the prompt with conversation history
        prompt = f"""You are a knowledgeable assistant helping to answer questions based on provided document context.

Context from the document:
---
{context}
---

{conversation_history}

Question: {query}

Instructions for providing your response:
1. Focus specifically on information found in the provided context
2. If the context contains relevant information:
   - Provide a clear, direct answer
   - Quote specific parts of the context to support your response
   - Explain any technical terms if present
3. If the context doesn't contain relevant information:
   - Clearly state that the information is not found in the provided context
   - Do not make assumptions or provide information outside the context
4. Keep your response concise but informative
5. Maintain consistency with any previous conversation context

Please provide your response:"""

        # Generate response with safety checks
        try:
            response = client.messages.create(
                model="claude-3-sonnet-20240229",
                max_tokens=1024,
                temperature=0,
                messages=[{"role": "user", "content": prompt}]
            )
            
            if not response or not hasattr(response, 'content'):
                logger.error("Invalid response format from Claude")
                return "I apologize, but I couldn't generate a proper response. Please try again."
                
            if not response.content:
                logger.error("Empty response received from Claude")
                return "I apologize, but I couldn't generate a response at this time. Please try again."
                
            logger.info("Successfully received response from Claude")
            return response.content[0].text.strip()

        except anthropic.APIError as api_error:
            logger.error(f"Error during Claude API call: {str(api_error)}")
            if "invalid_api_key" in str(api_error).lower():
                raise Exception("Invalid API key. Please check your ANTHROPIC_API_KEY environment variable.")
            return "I encountered an error while processing your request. Please try again or rephrase your question."
            
    except Exception as e:
        logger.error(f"Error getting LLM response: {str(e)}")
        if "invalid_api_key" in str(e).lower():
            raise Exception("Invalid API key. Please check your ANTHROPIC_API_KEY environment variable.")
        raise Exception(f"Failed to get LLM response: {str(e)}")
