def analyze_sql_query():
    """Analyze SQL query and its results"""
    try:
        test_data = {
            'date': ['2024-01-01', '2024-01-02', '2024-01-03', '2024-01-04', '2024-01-05'],
            'sales': [1000, 1200, 950, 1100, 1300],
            'category': ['A', 'B', 'A', 'B', 'A'],
            'region': ['North', 'South', 'North', 'South', 'North']
        }

        test_query = """
                SELECT date, sales, category, region
                FROM sales_data
                WHERE sales > 900
                GROUP BY category
                """

        request = SQLAnalysisRequest(
            sql_query=test_query,
            sample_data=test_data,
            analysis_type="comprehensive",
            generate_visualizations=True
        )
        # Convert sample data to DataFrame
        df = pd.DataFrame(request.sample_data)

        # Analyze query structure
        query_analysis = query_analyzer.analyze_query(request.sql_query)

        # Analyze data results
        data_analysis = data_analyzer.analyze_sql_results(
            df,
            request.sql_query,
            request.analysis_type,
            request.generate_visualizations
        )

        # Combine analyses
        return {
            "query_analysis": query_analysis,
            "data_analysis": data_analysis,
            "timestamp": datetime.now().isoformat()
        }
    except Exception as e:
        logger.error(f"Analysis error: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))


