logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Initialize FastAPI app
app = FastAPI(title="SQL Analysis API", description="API for analyzing SQL queries using Claude")


class SQLAnalysisRequest(BaseModel):
    sql_query: str
    sample_data: Dict[str, List]  # Sample data in format {column_name: [values]}
    analysis_type: Optional[str] = "comprehensive"
    generate_visualizations: Optional[bool] = True


class DataAnalyzer:
    def __init__(self, anthropic_client: Anthropic):
        self.anthropic = anthropic_client
        self._supported_chart_types = [
            'line', 'bar', 'scatter', 'pie', 'area',
            'heatmap', 'box', 'histogram'
        ]

    def analyze_sql_results(
            self,
            df: pd.DataFrame,
            sql_query: str,
            analysis_type: str = "comprehensive",
            generate_visualizations: bool = True
    ) -> Dict:
        """Analyze SQL query results using Claude"""
        try:
            # Get basic data summary
            data_summary = self._get_data_summary(df)

            # Generate analysis prompt based on type
            prompt = self._get_analysis_prompt(analysis_type)

            # Get Claude's analysis
            message = self.anthropic.messages.create(
                model="claude-3-sonnet-20240229",
                max_tokens=4000,
                messages=[{
                    "role": "user",
                    "content": f"""SQL Query: {sql_query}
                                 Data Summary: {json.dumps(data_summary, indent=2)}
                                 {prompt}"""
                }]
            )

            analysis_results = json.loads(message.content[0].text)

            # Generate visualization suggestions if requested
            if generate_visualizations:
                viz_suggestions = self._generate_visualization_suggestions(df, sql_query)
                analysis_results['visualizations'] = viz_suggestions

            # Generate sample visualizations with data
            numeric_cols = df.select_dtypes(include=[np.number]).columns
            categorical_cols = df.select_dtypes(exclude=[np.number]).columns

            sample_visualizations = []

            # Add time series visualization if applicable
            if len(df.columns) > 0:
                sample_visualizations.append({
                    "type": "line",
                    "title": "Time Series Analysis",
                    "description": "Trend analysis over time",
                    "config": {
                        "x": df.columns[0],
                        "y": list(numeric_cols),
                        "aggregation": None
                    },
                    "data": df.to_dict('records')
                })

            # Add category comparison if applicable
            if len(categorical_cols) > 0 and len(numeric_cols) > 0:
                agg_data = df.groupby(categorical_cols[0])[numeric_cols[0]].mean().reset_index()
                sample_visualizations.append({
                    "type": "bar",
                    "title": "Category Comparison",
                    "description": "Comparison across categories",
                    "config": {
                        "x": categorical_cols[0],
                        "y": [numeric_cols[0]],
                        "aggregation": "mean"
                    },
                    "data": agg_data.to_dict('records')
                })

            # Add scatter plot if multiple numeric columns exist
            if len(numeric_cols) >= 2:
                sample_visualizations.append({
                    "type": "scatter",
                    "title": "Correlation Analysis",
                    "description": "Relationship between numeric variables",
                    "config": {
                        "x": numeric_cols[0],
                        "y": numeric_cols[1],
                        "aggregation": None
                    },
                    "data": df.to_dict('records')
                })

            return {
                "analysis": analysis_results,
                "sample_visualizations": sample_visualizations,
                "data_summary": {
                    "total_rows": len(df),
                    "total_columns": len(df.columns),
                    "column_types": df.dtypes.astype(str).to_dict(),
                    "sample_data": df.head(5).to_dict('records')
                }
            }

        except Exception as e:
            logger.error(f"Analysis error: {str(e)}")
            raise

    def _get_data_summary(self, df: pd.DataFrame) -> Dict:
        """Generate summary statistics for the dataset"""
        summary = {
            'shape': df.shape,
            'dtypes': df.dtypes.astype(str).to_dict(),
            'missing': df.isnull().sum().to_dict(),
            'unique_counts': df.nunique().to_dict()
        }

        # Add numeric summary if applicable
        numeric_cols = df.select_dtypes(include=[np.number]).columns
        if len(numeric_cols) > 0:
            summary['numeric_summary'] = df[numeric_cols].describe().to_dict()

        return summary

    def _generate_visualization_suggestions(self, df: pd.DataFrame, sql_query: str) -> List[Dict]:
        """Generate visualization suggestions based on data characteristics"""
        try:
            numeric_cols = df.select_dtypes(include=['int64', 'float64']).columns
            categorical_cols = df.select_dtypes(include=['object']).columns
            datetime_cols = df.select_dtypes(include=['datetime64']).columns

            message = self.anthropic.messages.create(
                model="claude-3-sonnet-20240229",
                max_tokens=2000,
                messages=[{
                    "role": "user",
                    "content": f"""Suggest visualizations based on this data:

                                 SQL Query: {sql_query}
                                 Numeric columns: {list(numeric_cols)}
                                 Categorical columns: {list(categorical_cols)}
                                 Datetime columns: {list(datetime_cols)}
                                 Total rows: {len(df)}

                                 Return suggestions as JSON array:
                                 [
                                     {{
                                         "type": "chart_type",
                                         "title": "chart title",
                                         "description": "what this shows",
                                         "config": {{
                                             "x": "x-axis column",
                                             "y": ["y-axis column(s)"],
                                             "aggregation": "optional"
                                         }}
                                     }}
                                 ]"""
                }]
            )

            suggestions = json.loads(message.content[0].text)
            return suggestions if isinstance(suggestions, list) else []

        except Exception as e:
            logger.error(f"Visualization suggestion error: {str(e)}")
            return []

    def _get_analysis_prompt(self, analysis_type: str) -> str:
        """Get appropriate analysis prompt based on type"""
        prompts = {
            "comprehensive": """
                Analyze the dataset and provide JSON response with:
                {
                    "summary": {
                        "key_findings": [],
                        "patterns": [],
                        "anomalies": []
                    },
                    "recommendations": {
                        "data_quality": [],
                        "analysis": [],
                        "visualization": []
                    }
                }
            """,
            "data_quality": """
                Analyze data quality and provide JSON response with:
                {
                    "quality_metrics": {
                        "completeness": [],
                        "accuracy": [],
                        "consistency": []
                    },
                    "issues": {
                        "identified_problems": [],
                        "recommendations": []
                    }
                }
            """
        }
        return prompts.get(analysis_type, prompts["comprehensive"])


class SQLQueryAnalyzer:
    def __init__(self, anthropic_client: Anthropic):
        self.anthropic = anthropic_client

    def analyze_query(self, query: str) -> Dict:
        """Analyze SQL query structure and provide recommendations"""
        try:
            message = self.anthropic.messages.create(
                model="claude-3-sonnet-20240229",
                max_tokens=2000,
                messages=[{
                    "role": "user",
                    "content": f"""Analyze this SQL query and provide insights in JSON format:
                                 {query}

                                 Return analysis as:
                                 {{
                                     "structure": {{
                                         "type": "query type",
                                         "tables": [],
                                         "joins": [],
                                         "conditions": []
                                     }},
                                     "complexity": {{
                                         "level": "low/medium/high",
                                         "factors": []
                                     }},
                                     "recommendations": []
                                 }}"""
                }]
            )

            return json.loads(message.content[0].text)
        except Exception as e:
            logger.error(f"Query analysis error: {str(e)}")
            raise


