            <div className="space-y-2">
              {Object.entries(reward.details).map(([key, value]) => (
                <div key={key}>
                  <p className="text-sm font-medium text-gray-600 capitalize">
                    {key.replace(/([A-Z])/g, ' $1').trim()}
                  </p>
                  {Array.isArray(value) ? (
                    <ul className="mt-1 text-sm text-gray-500">
                      {value.map((item, i) => (
                        <li key={i}>{item}</li>
                      ))}
                    </ul>
                  ) : (
                    <p className="mt-1 text-sm text-gray-500">{value}</p>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  );

  const RewardDetails = ({ reward }) => (
    <div className="mt-2 p-4 bg-gray-50 rounded-lg">
      <div className="flex items-center justify-between mb-3">
        <div className="flex items-center gap-2">
          {REWARD_ICONS[reward.type] && 
            React.createElement(REWARD_ICONS[reward.type], { 
              className: "w-4 h-4 text-blue-500" 
            })
          }
          <h3 className="font-medium capitalize">{reward.type} Details</h3>
        </div>
        <button 
          onClick={() => setShowRewardDetails(null)}
          className="p-1 hover:bg-gray-100 rounded-full"
        >
          <X className="w-4 h-4 text-gray-400" />
        </button>
      </div>
      <div className="space-y-3">
        {Object.entries(reward.details).map(([key, value]) => (
          <div key={key}>
            <p className="text-sm font-medium text-gray-600 capitalize">
              {key.replace(/([A-Z])/g, ' $1').trim()}
            </p>
            {Array.isArray(value) ? (
              <ul className="mt-1 text-sm text-gray-500">
                {value.map((item, i) => (
                  <li key={i}>{item}</li>
                ))}
              </ul>
            ) : (
              <p className="mt-1 text-sm text-gray-500">{value}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  );

  return (
    <div className="min-h-screen bg-white">
      {/* Header */}
      <div className="px-4 py-4 flex items-center border-b border-gray-200">
        <button className="p-2">
          <ArrowLeft className="w-5 h-5 text-gray-600" />
        </button>
        <h1 className="ml-2 text-lg font-medium">Select Payment Method</h1>
      </div>

      {/* Order Summary Toggle */}
      <div className="px-4 py-3 border-b border-gray-200">
        <button 
          onClick={() => setShowOrderSummary(!showOrderSummary)}
          className="w-full flex items-center justify-between text-gray-600"
        >
          <div className="flex items-center gap-2">
            <span className="text-sm">Show order summary</span>
            <ChevronDown className="w-4 h-4" />
          </div>
          <span className="font-medium">$459.00</span>
        </button>
      </div>

      {/* Card Icons */}
      <div className="px-4 py-3 border-b border-gray-200">
        <div className="flex gap-2">
          <img src="/api/placeholder/32/20" alt="Visa" className="h-5 object-contain" />
          <img src="/api/placeholder/32/20" alt="Mastercard" className="h-5 object-contain" />
          <img src="/api/placeholder/32/20" alt="Amex" className="h-5 object-contain" />
        </div>
      </div>

      {/* Cards List */}
      <div className="px-4 py-2">
        {cards.map((card) => (
          <div key={card.id} className="mb-3">
            <label className="flex items-center">
              <input
                type="radio"
                name="payment-method"
                checked={selectedCard === card.id}
                onChange={() => setSelectedCard(card.id)}
                className="sr-only"
              />
              <div className={`
                flex-1 flex items-center p-3 border rounded-lg cursor-pointer
                ${selectedCard === card.id ? 'border-blue-500 bg-blue-50' : 'border-gray-200'}
              `}>
                <div className="flex items-center flex-1">
                  <div className={`w-4 h-4 rounded-full border-2 mr-3 flex items-center justify-center
                    ${selectedCard === card.id ? 'border-blue-500' : 'border-gray-300'}
                  `}>
                    {selectedCard === card.id && (
                      <div className="w-2 h-2 rounded-full bg-blue-500" />
                    )}
                  </div>
                  
                  <div className={`w-10 h-7 ${card.color} rounded`} />
                  
                  <div className="ml-3 flex-1">
                    <div className="flex justify-between items-center">
                      <p className="text-sm text-gray-900">{card.type}</p>
                      <RewardTypeIcons types={card.rewardTypes} cardId={card.id} />
                    </div>
                    <p className="text-sm text-gray-500">VISA •••• {card.last4}</p>
                  </div>
                </div>

                <button
                  onClick={(e) => {
                    e.preventDefault();
                    if (!showRewardDetails || showRewardDetails.cardId !== card.id || !showRewardDetails.showAll) {
                      setShowRewardDetails({ cardId: card.id, showAll: true });
                    } else {
                      setShowRewardDetails(null);
                    }
                  }}
                  className="p-2 hover:bg-gray-100 rounded-full ml-2"
                >
                  <ChevronRight className="w-4 h-4 text-gray-400" />
                </button>
              </div>
            </label>

            {showRewardDetails?.cardId === card.id && (
              showRewardDetails.showAll ? (
                <AllRewardDetails rewards={card.rewardTypes} />
              ) : (
                <RewardDetails 
                  reward={card.rewardTypes.find(r => r.type === showRewardDetails.type)}
                />
              )
            )}
          </div>
        ))}
      </div>

      {/* Place Order Button */}
      <div className="fixed bottom-0 left-0 right-0 p-4 bg-white border-t">
        <button className="w-full bg-gray-900 text-white py-3 rounded font-medium">
          Place Order
        </button>
      </div>
    </div>
  );
};

export default PaymentView;
