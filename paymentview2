import React, { useState } from 'react';
import { 
  ArrowLeft, 
  ChevronDown, 
  ChevronRight,
  Gift,
  Plane,
  Coins,
  Clock,
  X
} from 'lucide-react';

const REWARD_ICONS = {
  points: Gift,
  miles: Plane,
  cashback: Coins,
  installment: Clock
};

const PaymentView = () => {
  const [selectedCard, setSelectedCard] = useState(null);
  const [showOrderSummary, setShowOrderSummary] = useState(false);
  const [showRewardDetails, setShowRewardDetails] = useState(null);

  const cards = [
