      color: 'bg-gradient-to-r from-slate-900 to-slate-800',
      rewardTypes: [
        {
          type: 'points',
          details: {
            baseRate: "3X points per $1",
            bonusCategories: ["Travel: 5X", "Dining: 4X"],
            redemptionOptions: ["Travel Portal", "Gift Cards", "Cash"],
            currentBonus: "50% more points on electronics"
          }
        },
        {
          type: 'miles',
          details: {
            baseRate: "2 miles per $1",
            partnerAirlines: ["United", "Emirates", "Singapore Airlines"],
            transferRatio: "1:1 transfer to partners",
            currentBonus: "2X miles on electronics"
          }
        },
        {
          type: 'cashback',
          details: {
            baseRate: "2% on all purchases",
            categories: ["5% on Travel", "4% on Dining"],
            redemptionMin: "$25",
            currentBonus: "Additional 3% on electronics"
          }
        },
        {
          type: 'installment',
          details: {
            eligibleAmount: "Purchases over $100",
            terms: ["3 months", "6 months", "12 months"],
            interestRate: "0% for 12 months",
            minPayment: "Equal monthly payments"
          }
        }
      ]
    },
    {
      id: 2,
      type: 'Visa Signature',
      last4: '9876',
      color: 'bg-gradient-to-r from-blue-600 to-blue-500',
      rewardTypes: [
        {
          type: 'points',
          details: {
            baseRate: "2X points per $1",
            bonusCategories: ["Travel: 3X", "Dining: 3X"],
            redemptionOptions: ["Travel Portal", "Gift Cards"],
            currentBonus: "25% more points on electronics"
          }
        },
        {
          type: 'cashback',
          details: {
            baseRate: "1.5% on all purchases",
            categories: ["3% on Travel", "3% on Dining"],
            redemptionMin: "$25",
            currentBonus: "Additional 1.5% on electronics"
          }
        },
        {
          type: 'installment',
          details: {
            eligibleAmount: "Purchases over $200",
            terms: ["3 months", "6 months"],
            interestRate: "0% for 6 months",
            minPayment: "Equal monthly payments"
          }
        }
      ]
    },
    {
      id: 3,
      type: 'Visa Platinum',
      last4: '5432',
      color: 'bg-gradient-to-r from-slate-600 to-slate-500',
      rewardTypes: [
        {
          type: 'cashback',
          details: {
            baseRate: "1% on all purchases",
            categories: ["2% on Travel", "2% on Dining"],
            redemptionMin: "$25",
            currentBonus: "Additional 1% on electronics"
          }
        },
        {
          type: 'installment',
          details: {
            eligibleAmount: "Purchases over $500",
            terms: ["3 months"],
            interestRate: "0% for 3 months",
            minPayment: "Equal monthly payments"
          }
        }
      ]
    }
  ];

  const RewardTypeIcons = ({ types, cardId }) => (
    <div className="flex items-center gap-3">
      {types.map(({ type }) => {
        const IconComponent = REWARD_ICONS[type];
        return (
          <button
            key={type}
            onClick={(e) => {
              e.preventDefault();
              e.stopPropagation();
              setShowRewardDetails({ cardId, type, showAll: false });
            }}
            className="flex items-center hover:text-blue-500 transition-colors"
          >
            <IconComponent className="w-4 h-4" />
          </button>
        );
      })}
    </div>
  );

  const AllRewardDetails = ({ rewards }) => (
    <div className="mt-2 p-4 bg-gray-50 rounded-lg">
      <div className="flex items-center justify-between mb-3">
        <h3 className="font-medium">All Rewards</h3>
        <button 
          onClick={() => setShowRewardDetails(null)}
          className="p-1 hover:bg-gray-100 rounded-full"
        >
          <X className="w-4 h-4 text-gray-400" />
        </button>
      </div>
      <div className="space-y-4">
        {rewards.map((reward) => (
          <div key={reward.type} className="pb-3 border-b last:border-b-0">
            <div className="flex items-center gap-2 mb-2">
              {REWARD_ICONS[reward.type] && 
                React.createElement(REWARD_ICONS[reward.type], { 
                  className: "w-4 h-4 text-blue-500" 
                })
              }
