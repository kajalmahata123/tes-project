import React, { useState } from 'react';
import { 
  ChevronDown, 
  ChevronUp, 
  Database, 
  GitBranch, 
  Terminal, 
  AlertCircle,
  GitFork
} from 'lucide-react';

// Sample data from backend response
const sampleData = {
  query_understanding: {
    identified_entities: ["TVS_PCR_INFO"],
    relationships: [],
    conditions: [],
    aggregations: []
  },
  transformation_steps: [
    {
      step: "1",
      action: "Select all columns from TVS_PCR_INFO table",
      explanation: "Since the query asks for 'pcr info' without specifying any particular columns, we'll select all PCR information.",
      sql_component: "SELECT *"
    },
    {
      step: "2",
      action: "Specify the source table",
      explanation: "We identify the TVS_PCR_INFO table as the source for our query based on its relevance",
      sql_component: "FROM TVS_PCR_INFO"
    }
  ],
  generated_sql: "SELECT * FROM TVS_PCR_INFO",
  natural_explanation: "This SQL query retrieves all information about PCRs (Point of Compromise Records) such as PCR number, location information (city, state, country), phone number, and other relevant fields stored in the TVS_PCR_INFO table.",
  alternative_approaches: [
    {
      sql: "SELECT PCR, PCR_NM, CITY_NM, ST_NM, CTRY_NM, PHN_NUM FROM TVS_PCR_INFO",
      explanation: "This alternative query selects only specific columns that might be most relevant",
      trade_offs: "This approach reduces the amount of data returned, which could improve query performance."
    }
  ],
  complexity_analysis: {
    level: "simple",
    factors: [
      "No joins required",
      "No filtering conditions",
      "No aggregations"
    ],
    optimization_opportunities: [
      "If the table is large, consider adding pagination",
      "If specific columns are frequently accessed, consider creating an index on those columns",
      "If only certain columns are typically needed, consider selecting only those columns instead of using SELECT *"
    ]
  }
};

const SectionHeader = ({ title, isExpanded, onToggle, icon: Icon }) => (
  <div 
    onClick={onToggle}
    className="flex items-center justify-between p-4 cursor-pointer hover:bg-gray-50"
  >
    <div className="flex items-center gap-2">
      <Icon className="w-5 h-5 text-blue-600" />
      <h2 className="text-lg font-semibold text-gray-900">{title}</h2>
    </div>
    {isExpanded ? <ChevronUp className="w-5 h-5" /> : <ChevronDown className="w-5 h-5" />}
  </div>
);

const QueryAnalysisDisplay = () => {
  const [expandedSections, setExpandedSections] = useState({
    understanding: true,
    steps: true,
    sql: true,
    alternatives: false,
    complexity: false
  });

  const toggleSection = (section) => {
    setExpandedSections(prev => ({
      ...prev,
      [section]: !prev[section]
    }));
  };

  const getComplexityColor = (level) => {
    switch(level) {
      case 'simple': return 'text-green-600';
      case 'moderate': return 'text-yellow-600';
      case 'complex': return 'text-red-600';
      default: return 'text-gray-600';
    }
  };

  return (
    <div className="space-y-4 bg-white rounded-lg shadow">
      {/* Query Understanding Section */}
      <div className="border-b">
        <SectionHeader 
          title="Query Understanding"
          isExpanded={expandedSections.understanding}
          onToggle={() => toggleSection('understanding')}
          icon={Database}
        />
        {expandedSections.understanding && (
          <div className="p-4">
            <div className="grid md:grid-cols-2 gap-6">
              <div>
                <h3 className="font-medium text-gray-900 mb-2">Identified Entities</h3>
                <ul className="list-disc pl-5 space-y-1">
                  {sampleData.query_understanding.identified_entities.map((entity, idx) => (
                    <li key={idx} className="text-gray-600">{entity}</li>
                  ))}
                </ul>
              </div>
              <div>
                <h3 className="font-medium text-gray-900 mb-2">Relationships</h3>
                <p className="text-gray-600">No relationships identified</p>
              </div>
            </div>
          </div>
        )}
      </div>

      {/* Transformation Steps */}
      <div className="border-b">
        <SectionHeader 
          title="Transformation Steps"
          isExpanded={expandedSections.steps}
          onToggle={() => toggleSection('steps')}
          icon={GitBranch}
        />
        {expandedSections.steps && (
          <div className="p-4">
            <div className="space-y-6">
              {sampleData.transformation_steps.map((step, idx) => (
                <div key={idx} className="border-l-2 border-blue-500 pl-4">
                  <h3 className="font-medium text-gray-900">
                    Step {step.step}: {step.action}
                  </h3>
                  <p className="text-gray-600 mt-1">{step.explanation}</p>
                  <code className="block bg-gray-50 p-3 mt-2 rounded text-sm overflow-x-auto">
                    {step.sql_component}
                  </code>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      {/* Generated SQL */}
      <div className="border-b">
        <SectionHeader 
          title="Generated SQL"
          isExpanded={expandedSections.sql}
          onToggle={() => toggleSection('sql')}
          icon={Terminal}
        />
        {expandedSections.sql && (
          <div className="p-4 space-y-4">
            <code className="block bg-gray-50 p-4 rounded text-sm overflow-x-auto whitespace-pre-wrap">
              {sampleData.generated_sql}
            </code>
            <div className="bg-blue-50 p-4 rounded">
              <p className="text-gray-700">{sampleData.natural_explanation}</p>
            </div>
          </div>
        )}
      </div>

      {/* Alternative Approaches */}
      <div className="border-b">
        <SectionHeader 
          title="Alternative Approaches"
          isExpanded={expandedSections.alternatives}
          onToggle={() => toggleSection('alternatives')}
          icon={GitFork}
        />
        {expandedSections.alternatives && (
          <div className="p-4">
            <div className="space-y-6">
              {sampleData.alternative_approaches.map((approach, idx) => (
                <div key={idx} className="border-l-2 border-gray-300 pl-4">
                  <code className="block bg-gray-50 p-3 rounded text-sm overflow-x-auto">
                    {approach.sql}
                  </code>
                  <p className="mt-2 text-gray-700">{approach.explanation}</p>
                  <p className="mt-1 text-gray-500 text-sm">{approach.trade_offs}</p>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      {/* Complexity Analysis */}
      <div>
        <SectionHeader 
          title="Complexity Analysis"
          isExpanded={expandedSections.complexity}
          onToggle={() => toggleSection('complexity')}
          icon={AlertCircle}
        />
        {expandedSections.complexity && (
          <div className="p-4">
            <div className="space-y-4">
              <div className="flex items-center">
                <span className="font-medium mr-2">Complexity Level:</span>
                <span className={`${getComplexityColor(sampleData.complexity_analysis.level)} font-medium`}>
                  {sampleData.complexity_analysis.level.toUpperCase()}
                </span>
              </div>
              
              <div>
                <h3 className="font-medium text-gray-900 mb-2">Contributing Factors</h3>
                <ul className="list-disc pl-5 space-y-1">
                  {sampleData.complexity_analysis.factors.map((factor, idx) => (
                    <li key={idx} className="text-gray-600">{factor}</li>
                  ))}
                </ul>
              </div>

              <div>
                <h3 className="font-medium text-gray-900 mb-2">Optimization Opportunities</h3>
                <ul className="list-disc pl-5 space-y-1">
                  {sampleData.complexity_analysis.optimization_opportunities.map((opt, idx) => (
                    <li key={idx} className="text-gray-600">{opt}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

export default QueryAnalysisDisplay;
