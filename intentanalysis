import React, { useState } from 'react';
import { Search, Loader2 } from 'lucide-react';
import QueryAnalysisDisplay from './query-analysis-display';

// Updated interface to match exact response structure
interface QueryResponse {
  query_understanding: {
    identified_entities: string[];
    relationships: string[];
    conditions: string[];
    aggregations: string[];
  };
  transformation_steps: Array<{
    step: string;
    action: string;
    explanation: string;
    sql_component: string;
  }>;
  generated_sql: string;
  natural_explanation: string;
  alternative_approaches: Array<{
    sql: string;
    explanation: string;
    trade_offs: string;
  }>;
  complexity_analysis: {
    level: 'simple' | 'moderate' | 'complex';
    factors: string[];
    optimization_opportunities: string[];
  };
}

const QueryIntentAnalysis = () => {
  const [query, setQuery] = useState('');
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [analysisResult, setAnalysisResult] = useState<QueryResponse | null>(null);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!query.trim()) return;

    setIsLoading(true);
    setError(null);

    try {
      const accessToken = localStorage.getItem('accessToken');
      if (!accessToken) {
        throw new Error('Authentication required');
      }

      const response = await fetch('http://127.0.0.1:8001/api/v1/query-analysis/analyze', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${accessToken}`
        },
        body: JSON.stringify({
          query: query.trim()
        })
      });

      if (response.status === 401) {
        throw new Error('Session expired. Please login again.');
      }

      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.message || 'Failed to analyze query');
      }

      const data: QueryResponse = await response.json();
      
      // Validate the response structure
      if (!data.query_understanding || !data.transformation_steps || !data.generated_sql) {
        throw new Error('Invalid response format from server');
      }

      setAnalysisResult(data);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'An error occurred');
      if (err instanceof Error && err.message.includes('login')) {
        // Handle session expiry - redirect to login or show login modal
        console.log('Session expired, handle redirect');
      }
    } finally {
      setIsLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-gray-50 py-8">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div className="space-y-8">
          {/* Input Section */}
          <div className="bg-white rounded-lg shadow p-6">
            <form onSubmit={handleSubmit} className="space-y-4">
              <div>
                <label
                  htmlFor="query"
                  className="block text-sm font-medium text-gray-700 mb-2"
                >
                  Natural Language Query
                </label>
                <div className="relative rounded-md shadow-sm">
                  <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <Search className="h-5 w-5 text-gray-400" />
                  </div>
                  <textarea
                    id="query"
                    rows={3}
                    className="block w-full pl-10 pr-12 py-2 sm:text-sm border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
                    placeholder="Enter your query in natural language (e.g., 'Show me all PCR information from TVS_PCR_INFO table')"
                    value={query}
                    onChange={(e) => setQuery(e.target.value)}
                  />
                </div>
              </div>

              <div className="flex justify-end">
                <button
                  type="submit"
                  disabled={isLoading || !query.trim()}
                  className="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  {isLoading ? (
                    <>
                      <Loader2 className="animate-spin -ml-1 mr-2 h-4 w-4" />
                      Analyzing...
                    </>
                  ) : (
                    'Analyze Query'
                  )}
                </button>
              </div>
            </form>

            {error && (
              <div className="mt-4 p-4 bg-red-50 border border-red-200 rounded-md">
                <p className="text-sm text-red-600">{error}</p>
              </div>
            )}
          </div>

          {/* Analysis Result */}
          {analysisResult && (
            <div className="mt-8">
              <QueryAnalysisDisplay queryInput={analysisResult} />
            </div>
          )}
        </div>
      </div>
    </div>
  );
};

export default QueryIntentAnalysis;
