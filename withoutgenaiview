                        {expandedCard === card.id && (
                          <div className="px-4 pb-4">
                            <div className="p-3 bg-gray-50 rounded-xl">
                              <p className="text-sm font-medium">Card Details</p>
                              <p className="text-xs text-gray-600 mt-1">Expires: {card.expiry}</p>
                              <p className="text-xs text-gray-600">Rewards Rate: {card.baseRewards[category] || card.baseRewards.default}x points on {category}</p>
                            </div>
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                </div>

                {/* Bottom Button - Contained within scroll area */}
                <div className="bg-white border-t border-gray-100 mt-auto">
                  <div className="px-5 py-4 pb-8">
                    <button 
                      className="w-full bg-black text-white py-3.5 rounded-2xl font-medium disabled:bg-gray-300"
