                            type="radio"
                            checked={selectedMethod === card.id}
                            onChange={() => setSelectedMethod(card.id)}
                            className="w-4 h-4 border-gray-300"
                          />

                          <div className={`w-12 h-8 ${card.color} rounded-xl ml-3 flex items-center justify-center`}>
                            <span className="text-white text-xs font-medium">{card.network}</span>
                          </div>

                          <div className="ml-3 flex-1">
                            <div className="flex items-center justify-between">
                              <div>
