import { ArrowLeft, Battery, Signal, Wifi } from 'lucide-react';

interface Card {
  id: number;
  type: string;
  network: string;
  tier: string;
  last4: string;
  color: string;
  expiry: string;
  baseRewards: {
    default: number;
    [key: string]: number;
  };
}

const SAMPLE_CARDS: Card[] = [
  {
    id: 1,
    type: "Credit Card",
    network: "VISA",
    tier: "Signature",
    last4: "5678",
    color: "bg-emerald-400",
    expiry: "04/28",
    baseRewards: {
      default: 1,
      Electronics: 2,
      Travel: 3
    }
  },
  {
    id: 2,
    type: "Credit Card",
    network: "VISA",
    tier: "Infinite",
    last4: "0910",
    color: "bg-blue-400",
    expiry: "05/27",
    baseRewards: {
      default: 1.5,
      Electronics: 2.5,
      Dining: 3
    }
  },
  {
    id: 3,
    type: "Credit Card",
    network: "VISA",
    tier: "Platinum",
    last4: "3456",
    color: "bg-gray-400",
    expiry: "09/26",
    baseRewards: {
      default: 1,
      Electronics: 1.5,
      Groceries: 2
    }
  }
];

const PaymentView = () => {
  const amount = 999.99;
  const merchant = "Apple Store";
  const category = "Electronics";
  const [selectedMethod, setSelectedMethod] = React.useState<number | null>(null);
  const [expandedCard, setExpandedCard] = React.useState<number | null>(null);

  return (
    <div className="min-h-screen bg-gray-100 flex items-center justify-center p-4">
      <div className="w-[393px] h-[852px] bg-black rounded-[60px] shadow-xl overflow-hidden relative border-8 border-black">
        {/* Dynamic Island */}
        <div className="absolute top-0 left-1/2 -translate-x-1/2 h-[35px] w-[126px] bg-black rounded-b-[18px] z-50 mt-2">
          <div className="absolute top-[10px] w-[90px] h-[9px] bg-neutral-900 rounded-[18px] left-1/2 -translate-x-1/2" />
          <div className="absolute right-[22px] top-[7px] w-[13px] h-[13px] rounded-full bg-neutral-950" />
        </div>

        {/* Screen Content */}
        <div className="h-full w-full bg-white rounded-[50px] overflow-hidden">
          {/* Status Bar */}
          <div className="h-12 bg-white flex items-center justify-between px-6 pt-2">
