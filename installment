# smart_ql/utils/dependencies.py
from fastapi import Depends, HTTPException, Security, status
from fastapi.security import HTTPAuthorizationCredentials, HTTPBearer
from smart_ql.features.auth.core.dependencies import get_auth_service
from smart_ql.features.auth.models.user import User
from smart_ql.features.auth.services.auth_service import AuthService

security = HTTPBearer()

async def get_current_user(
    credentials: HTTPAuthorizationCredentials = Security(security),
    auth_service: AuthService = Depends(get_auth_service)
) -> User:
    """Dependency to get current authenticated user"""
    return await auth_service.get_current_user(credentials.credentials)
