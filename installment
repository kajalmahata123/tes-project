import React from 'react';
import {
  LineChart, Line, BarChart, Bar, ScatterChart, Scatter,
  PieChart, Pie, AreaChart, Area, ComposedChart, Cell,
  XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer
} from 'recharts';
import { Card, CardHeader, CardTitle, CardContent } from '@/components/ui/card';

// Color palette for charts
const COLORS = [
  '#8884d8', '#82ca9d', '#ffc658', '#ff8042', '#00C49F',
  '#FFBB28', '#FF8042', '#0088FE', '#00C49F', '#FFBB28'
];

// Interface for chart configuration
interface ChartConfig {
  x: string;
  y: string | string[];
  aggregation?: string;
}

// Interface for visualization
interface Visualization {
  type: string;
  title: string;
  description: string;
  data: any[];
  config: ChartConfig;
}

const ChartContainer = ({ children, title, description }) => (
  <Card className="mb-6">
    <CardHeader>
      <CardTitle className="text-lg font-semibold">{title}</CardTitle>
      {description && (
        <p className="text-sm text-gray-600">{description}</p>
      )}
    </CardHeader>
    <CardContent>
      <div className="h-[400px] w-full">
        <ResponsiveContainer width="100%" height="100%">
          {children}
        </ResponsiveContainer>
      </div>
    </CardContent>
  </Card>
);

const DynamicChartRenderer = ({ visualization }: { visualization: Visualization }) => {
  const { type, title, description, data, config } = visualization;

  // Helper function to get Y-axis keys
  const getYKeys = (config: ChartConfig): string[] => {
    if (Array.isArray(config.y)) return config.y;
    return [config.y];
  };

  // Render different chart types
  const renderChart = () => {
    const yKeys = getYKeys(config);

    switch (type.toLowerCase()) {
      case 'line':
        return (
          <LineChart data={data}>
            <CartesianGrid strokeDasharray="3 3" />
            <XAxis dataKey={config.x} />
            <YAxis />
            <Tooltip />
            <Legend />
            {yKeys.map((key, index) => (
              <Line
                key={key}
                type="monotone"
                dataKey={key}
                stroke={COLORS[index % COLORS.length]}
                dot={{ r: 4 }}
                activeDot={{ r: 6 }}
              />
            ))}
          </LineChart>
        );

      case 'bar':
        return (
          <BarChart data={data}>
            <CartesianGrid strokeDasharray="3 3" />
            <XAxis dataKey={config.x} />
            <YAxis />
            <Tooltip />
            <Legend />
            {yKeys.map((key, index) => (
              <Bar
                key={key}
                dataKey={key}
                fill={COLORS[index % COLORS.length]}
              />
            ))}
          </BarChart>
        );

      case 'scatter':
        return (
          <ScatterChart>
            <CartesianGrid strokeDasharray="3 3" />
            <XAxis dataKey={config.x} type="number" />
            <YAxis dataKey={yKeys[0]} type="number" />
            <Tooltip cursor={{ strokeDasharray: '3 3' }} />
            <Legend />
            <Scatter
              name={title}
              data={data}
              fill={COLORS[0]}
            />
          </ScatterChart>
        );

      case 'pie':
        return (
          <PieChart>
            <Pie
              data={data}
              dataKey={yKeys[0]}
              nameKey={config.x}
              cx="50%"
              cy="50%"
              outerRadius={150}
              label
            >
              {data.map((entry, index) => (
                <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
              ))}
            </Pie>
            <Tooltip />
            <Legend />
          </PieChart>
        );

      case 'area':
        return (
          <AreaChart data={data}>
            <CartesianGrid strokeDasharray="3 3" />
            <XAxis dataKey={config.x} />
            <YAxis />
            <Tooltip />
            <Legend />
            {yKeys.map((key, index) => (
              <Area
                key={key}
                type="monotone"
                dataKey={key}
                stackId="1"
                stroke={COLORS[index % COLORS.length]}
                fill={COLORS[index % COLORS.length]}
              />
            ))}
          </AreaChart>
        );

      case 'composed':
        return (
          <ComposedChart data={data}>
            <CartesianGrid strokeDasharray="3 3" />
            <XAxis dataKey={config.x} />
            <YAxis />
            <Tooltip />
            <Legend />
            {yKeys.map((key, index) => (
              index === 0 ? (
                <Bar
                  key={key}
                  dataKey={key}
                  fill={COLORS[index % COLORS.length]}
                />
              ) : (
                <Line
                  key={key}
                  type="monotone"
                  dataKey={key}
                  stroke={COLORS[index % COLORS.length]}
                />
              )
            ))}
          </ComposedChart>
        );

      default:
        return (
          <div className="flex items-center justify-center h-full">
            <p className="text-gray-500">Unsupported chart type: {type}</p>
          </div>
        );
    }
  };

  return (
    <ChartContainer title={title} description={description}>
      {renderChart()}
    </ChartContainer>
  );
};

// Component to render all visualizations
const VisualizationRenderer = ({ 
  visualizations 
}: { 
  visualizations: Visualization[] 
}) => {
  return (
    <div className="space-y-6">
      {visualizations.map((viz, index) => (
        <DynamicChartRenderer key={index} visualization={viz} />
      ))}
    </div>
  );
};

export default VisualizationRenderer;
